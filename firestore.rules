rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin gateway (read-only, key-based access)
    match /akk/{key} {
      allow read: if true;
      allow write: if false;
    }

    // Admin root docs
    match /ak/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Admin sub-docs (workers list, etc.)
    match /ak/{id}/d/{sub} {
      allow read, write: if true;
    }

    // Admin activity log
    match /ak/{id}/act/{logId} {
      allow read, write: if true;
    }

    // Admin alert orders
    match /ak/{id}/ao/{orderId} {
      allow read: if true;
    }

    // Order gateway (read-only)
    match /okk/{key} {
      allow read: if true;
      allow write: if false;
    }

    // Order root docs
    match /ok/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Order sub-docs (items, emb, img_*, pics_*)
    match /ok/{id}/d/{sub} {
      allow read: if true;
    }

    // Order customer entries
    match /ok/{id}/c/{cId} {
      allow read: if true;
    }

    // Order entries (new orders from web)
    match /ok/{id}/o/{oId} {
      allow read, write: if true;
    }

    // Worker docs
    match /wk/{token} {
      allow read, write: if true;
    }

    // Worker work entries
    match /wk/{token}/e/{entryId} {
      allow read, write: if true;
    }

    // Worker extras set in Admin (mobile, blocked) + deductions – the shop PC never touches these
    match /wkx/{token} {
      allow read, write: if true;
    }
    match /wkx/{token}/ded/{dId} {
      allow read, write: if true;
    }

    // Work in progress (worker pressed Start, not Finish yet)
    match /jwip/{id} {
      allow read, write: if true;
    }

    // Space/order data (ShopSync writes, pages read)
    match /sp/{key} {
      allow read: if true;
      allow write: if true;
    }

    // System config (rates etc.)
    match /sys/{docId} {
      allow read, write: if true;
    }

    // Data sync (ShopSync writes shop data here for the phone app)
    match /ds/{name} {
      allow read, write: if true;
    }
    match /ds/{name}/c/{piece} {
      allow read, write: if true;
    }

    // Jobs (phone → shop PC task queue)
    match /jobs/{jobId} {
      allow read, write: if true;
    }

    // Files (PDF storage from shop PC)
    match /files/{fileId} {
      allow read: if true;
    }
    match /files/{fileId}/p/{partId} {
      allow read: if true;
    }
  }
}
